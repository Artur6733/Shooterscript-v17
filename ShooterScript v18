--==================================================
-- RENDER LOOP (NEAREST PLAYER ONLY)
--==================================================

RunService:BindToRenderStep("SpectatorSystem", Enum.RenderPriority.Camera.Value + 1, function()
	local camera = Workspace.CurrentCamera
	if not camera then 
		hideVisuals()
		return 
	end

	local showEsp = getEspState()
	local aimOn = getAimState()

	if not showEsp and not aimOn then
		hideVisuals()
		return
	end

	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?

	if not myRoot then
		hideVisuals()
		return
	end

	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then 
		hideVisuals()
		return 
	end
	local screenCenter = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)

	-- ПОИСК ТОЛЬКО САМОГО БЛИЗКОГО ИГРОКА
	local nearestPlayer: Player? = nil
	local nearestChar: Model? = nil
	local nearestHeadPos: Vector3? = nil
	local minDistance = CONFIG.MAX_DISTANCE

	for _, player in Players:GetPlayers() do
		if player == localPlayer then continue end

		local char = player.Character
		if not char then continue end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

		if not hum or hum.Health <= 0 or not root then continue end

		local dist = (root.Position - myRoot.Position).Magnitude
		if dist < minDistance then
			minDistance = dist
			nearestPlayer = player
			nearestChar = char
			local head = char:FindFirstChild("Head") :: BasePart?
			nearestHeadPos = head and head.Position or (root.Position + Vector3.new(0, 1.5, 0))
		end
	end

	-- РИСОВАНИЕ ДЛЯ БЛИЖАЙШЕГО ИГРОКА
	if nearestChar and showEsp then
		local root = nearestChar:FindFirstChild("HumanoidRootPart") :: BasePart
		local rootPos = root.Position
		local headPos = nearestHeadPos or (rootPos + Vector3.new(0, 1.5, 0))

		local topWorld = headPos + Vector3.new(0, 1.2, 0)
		local bottomWorld = rootPos - Vector3.new(0, 3.2, 0)

		-- Использован WorldToScreenPoint для идеального совпадения с мышью/экраном
		local topScreen, topOnScreen = camera:WorldToScreenPoint(topWorld)
		local bottomScreen, bottomOnScreen = camera:WorldToScreenPoint(bottomWorld)

		if topOnScreen and bottomOnScreen and topScreen.Z > 0 then
			local height = math.abs(topScreen.Y - bottomScreen.Y)
			local width = height * 0.65

			local boxPos = Vector2.new(topScreen.X - width / 2, topScreen.Y)
			box.Size = Vector2.new(width, height)
			box.Position = boxPos
			box.Visible = true

			-- Трейсер ведется ровно из центра экрана к центру ESP-квадрата
			local espCenter = Vector2.new(topScreen.X, topScreen.Y + (height / 2))
			tracer.From = screenCenter
			tracer.To = espCenter
			tracer.Visible = true
		else
			hideVisuals()
		end
	else
		hideVisuals()
	end

	-- НАВОДКА КАМЕРЫ (ТОЛЬКО НА БЛИЖАЙШЕГО)
	if aimOn and nearestHeadPos then
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, nearestHeadPos)
	end
end)
